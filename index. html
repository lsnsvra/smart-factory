<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        
        // 1. Role / View Switcher Logic
        const navItems = document.querySelectorAll('.nav-item-role');
        const views = document.querySelectorAll('.role-view');
        const headerTitle = document.getElementById('header-title');
        const userRoleText = document.getElementById('current-user-role');

        const titleMap = {
            'view-ppic': 'PPIC - Master Planning Schedule',
            'view-operator': 'HMI Operator Dashboard',
            'view-mizu': 'Mizusumashi Logistic Control',
            'view-leader': 'Line Leader Action Desk',
            'view-spv': 'Supervisor Command Center',
            'view-mgr': 'Executive Analytics Dashboard'
        };

        const roleMap = {
            'view-ppic': 'PPIC Staff',
            'view-operator': 'Operator Produksi',
            'view-mizu': 'Mizusumashi',
            'view-leader': 'Line Leader',
            'view-spv': 'Supervisor',
            'view-mgr': 'Manager'
        };

        navItems.forEach(item => {
            item.addEventListener('click', function() {
                // Update active class on nav
                navItems.forEach(nav => nav.classList.remove('active'));
                this.classList.add('active');

                // Switch View
                const target = this.getAttribute('data-target');
                views.forEach(view => {
                    view.classList.remove('active');
                    if(view.id === target) {
                        view.classList.add('active');
                    }
                });

                // Update text
                headerTitle.innerText = titleMap[target];
                userRoleText.innerText = roleMap[target];
            });
        });

        // 2. Real-time Clock Logic
        function updateClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('id-ID', { hour12: false });
            document.getElementById('realtime-clock').innerText = timeStr + ' WIB';
        }
        setInterval(updateClock, 1000);
        updateClock();

        // 3. Chart.js Initialization (Manager View)
        Chart.defaults.color = '#9ca3af';
        Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";

        // Line Chart - Trend
        const ctxTrend = document.getElementById('trendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
                datasets: [
                    {
                        label: 'Aktual Produksi',
                        data: [720, 740, 710, 750, 690, 745, 760],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true
                    },
                    {
                        label: 'Target Plan',
                        data: [750, 750, 750, 750, 750, 750, 750],
                        borderColor: '#374151',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        tension: 0
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'top' } },
                scales: { 
                    y: { grid: { color: '#374151' }, min: 600, max: 800 },
                    x: { grid: { display: false } }
                }
            }
        });

        // Pie Chart - Loss Breakdown
        const ctxLoss = document.getElementById('lossChart').getContext('2d');
        new Chart(ctxLoss, {
            type: 'doughnut',
            data: {
                labels: ['Machine Error', 'Part NG', 'Setup/Changeover', 'Wait Material'],
                datasets: [{
                    data: [45, 25, 20, 10],
                    backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12 } }
                }
            }
        });
    });
</script>

