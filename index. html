<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Cerdas Berbasis Data | PT. DENSO INDONESIA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* === CORE VARIABLES & THEME === */
        :root {
            --mes-dark-bg: #0b0f19;
            --mes-sidebar-bg: #111827;
            --mes-card-bg: #1f2937;
            --mes-border: #374151;
            --mes-primary: #3b82f6;
            --mes-success: #10b981;
            --mes-warning: #f59e0b;
            --mes-danger: #ef4444;
            --mes-text-main: #f3f4f6;
            --mes-text-muted: #9ca3af;
            --sidebar-width: 260px;
        }

        body {
            background-color: var(--mes-dark-bg);
            color: var(--mes-text-main);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow: hidden; /* Prevent full body scroll, handle in main-content */
        }

        /* === LAYOUT ARCHITECTURE === */
        .wrapper {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--mes-sidebar-bg);
            border-right: 1px solid var(--mes-border);
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }
        
        .sidebar-brand {
            padding: 1.5rem;
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: 1px;
            color: #fff;
            border-bottom: 1px solid var(--mes-border);
            text-transform: uppercase;
        }

        .nav-menu {
            padding: 1rem 0;
            overflow-y: auto;
            flex-grow: 1;
        }

        .menu-title {
            padding: 0.5rem 1.5rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--mes-text-muted);
            letter-spacing: 1px;
            font-weight: 600;
        }

        .nav-item-role {
            padding: 0.75rem 1.5rem;
            color: var(--mes-text-muted);
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }

        .nav-item-role:hover, .nav-item-role.active {
            background-color: rgba(59, 130, 246, 0.1);
            color: #fff;
            border-left-color: var(--mes-primary);
        }

        .nav-item-role i { margin-right: 12px; font-size: 1.1rem; }

        /* MAIN CONTENT AREA */
        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-navbar {
            height: 70px;
            background-color: rgba(17, 24, 39, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--mes-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
        }

        .content-scrollable {
            flex-grow: 1;
            padding: 2rem;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* === UI COMPONENTS === */
        .mes-card {
            background-color: var(--mes-card-bg);
            border: 1px solid var(--mes-border);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            height: 100%;
        }

        .kpi-value {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin: 0.5rem 0;
        }

        /* Status Indicators & Animation */
        .status-dot {
            display: inline-block;
            width: 10px; height: 10px;
            border-radius: 50%;
            margin-right: 8px;
        }
        .status-active { background: var(--mes-success); box-shadow: 0 0 8px var(--mes-success); animation: blink 2s infinite; }
        .status-error { background: var(--mes-danger); box-shadow: 0 0 8px var(--mes-danger); animation: blink 1s infinite; }

        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

        /* Complex Data Table */
        .mes-table { width: 100%; color: var(--mes-text-main); border-collapse: separate; border-spacing: 0; }
        .mes-table th {
            background-color: rgba(55, 65, 81, 0.5);
            padding: 1rem;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--mes-border);
        }
        .mes-table td { padding: 1rem; border-bottom: 1px solid var(--mes-border); vertical-align: middle; }
        .mes-table tr:hover td { background-color: rgba(255, 255, 255, 0.02); }
        .row-critical { background-color: rgba(239, 68, 68, 0.1) !important; border-left: 4px solid var(--mes-danger); }

        /* Kanban Board Style */
        .kanban-board { display: flex; gap: 1.5rem; align-items: flex-start; }
        .kanban-col {
            flex: 1;
            background: rgba(17, 24, 39, 0.5);
            border: 1px dashed var(--mes-border);
            border-radius: 12px;
            padding: 1rem;
            min-height: 60vh;
        }
        .kanban-card {
            background: var(--mes-card-bg);
            border: 1px solid var(--mes-border);
            border-left: 4px solid var(--mes-primary);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            cursor: grab;
            transition: transform 0.2s;
        }
        .kanban-card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2); }
        .kanban-card.urgent { border-left-color: var(--mes-danger); }

        /* View Switcher Logic */
        .role-view { display: none; animation: fadeIn 0.4s ease-in-out; }
        .role-view.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--mes-dark-bg); }
        ::-webkit-scrollbar-thumb { background: var(--mes-border); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--mes-text-muted); }
    </style>
</head>
<body>

<div class="wrapper">
